# Supabase self-hosted — copy to .env
NEXT_PUBLIC_SUPABASE_URL=https://api.mibchemicals.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_from_vps_opt_supabase_docker_env

# Optional: public URL of the site (used in sitemap / metadata)
NEXT_PUBLIC_SITE_URL=https://mibchemicals.com

# Optional: nomor WhatsApp (hanya digit, contoh 6281234567890). Jika kosong, dipakai contact_phone dari site config.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional (fallback): Google Analytics 4 Measurement ID (contoh G-XXXXXXXXXX).
# Disarankan diatur dari Admin -> Pengaturan situs -> Analytics. Env ini hanya dipakai jika field admin kosong.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
